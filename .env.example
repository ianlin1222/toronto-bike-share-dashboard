# Copy to .env. Never commit the populated file.
POSTGRES_DB=bikeshare
POSTGRES_USER=bikeshare_admin
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_PORT=55432
BIKESHARE_API_PORT=8080
BIKESHARE_INGEST_PASSWORD=replace-with-a-distinct-ingestion-password
BIKESHARE_API_PASSWORD=replace-with-a-distinct-api-password
BIKESHARE_REPORTER_PASSWORD=replace-with-a-distinct-reporting-password

# URL-encode passwords if they contain URI-reserved characters.
BIKESHARE_MIGRATION_DATABASE_URL=postgresql+psycopg://bikeshare_admin:replace-with-a-long-local-password@db:5432/bikeshare
BIKESHARE_INGEST_DATABASE_URL=postgresql+psycopg://bikeshare_ingest:replace-with-a-distinct-ingestion-password@db:5432/bikeshare
BIKESHARE_API_DATABASE_URL=postgresql+psycopg://bikeshare_api:replace-with-a-distinct-api-password@db:5432/bikeshare
BIKESHARE_REPORTING_DATABASE_URL=postgresql+psycopg://bikeshare_reporter:replace-with-a-distinct-reporting-password@db:5432/bikeshare
BIKESHARE_APP_MODE=live_baseline
BIKESHARE_LOG_LEVEL=INFO
BIKESHARE_BIND_HOST=0.0.0.0
BIKESHARE_BIND_PORT=8000
BIKESHARE_GBFS_DISCOVERY_URL=https://toronto.publicbikesystem.net/customer/gbfs/v3.0/gbfs.json
BIKESHARE_SOURCE_CONTACT=replace-with-project-contact
BIKESHARE_STATUS_POLL_SECONDS=60
BIKESHARE_METADATA_POLL_SECONDS=900
BIKESHARE_COMPLETE_BATCH_MAX_AGE_SECONDS=120
BIKESHARE_STATION_MAX_AGE_SECONDS=300
BIKESHARE_PARTIAL_BATCH_MIN_COVERAGE=0.95
BIKESHARE_DESTINATION_RETENTION_DECIMALS=3
BIKESHARE_ACTIVE_MODEL_RUN_ID=
BIKESHARE_MODEL_ROOT=/app/var/models
